### THIS IS AN EXAMPLE - CHANGE IT TO YOUR NEEDS ###

# Host-Path and User
HOST_BUILD_DIR=/home/user/xiegu/docker/x6100_gui

# check this with id -u and id -g
HOST_UID=1000
HOST_GID=1000

# Repos / Branches
#GUI_REPO=https://github.com/OpenX6100/x6100_gui.git
GUI_BRANCH=v1.0.2
#BR_REPO=https://github.com/OpenX6100/AetherX6100Buildroot.git
BR_BRANCH=master
IMAGE_TAG=v1.0.2

# Optional Switches 0=use not 1=use you can also use yes/no or true/false
ENABLE_UBOOT=0
ENABLE_MC=0
ENABLE_PROCPS_NG=0
